# Local development defaults.
APP_ENV=local
DATABASE_URL=sqlite:///server/data/collector.dev.db

# Use a strong value before deploying.
COLLECTOR_TOKEN=change_me
ADMIN_PASSWORD=change_me

# Enterprise WeChat group robot webhook.
WECOM_WEBHOOK_URL=

# Server example:
# APP_ENV=production
# DATABASE_URL=sqlite:////opt/series-monitor/server/data/collector.prod.db
